<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="ir_cron_send_price_change_digest" model="ir.cron">
        <field name="name">Pricelists: send daily price change digest</field>
        <field name="model_id" ref="model_product_pricelist_change_log" />
        <field name="state">code</field>
        <field name="code">model._cron_send_price_change_digest()</field>
        <field name="interval_number" eval="1" />
        <field name="interval_type">days</field>
        <field name="active" eval="True" />
        <field name="nextcall" eval="DateTime.now().strftime('%Y-%m-%d 20:00:00')" />
    </record>
</odoo>
