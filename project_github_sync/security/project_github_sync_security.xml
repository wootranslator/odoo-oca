<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="project_github_repo_company_rule" model="ir.rule">
        <field name="name">GitHub repository: multi-company</field>
        <field name="model_id" ref="model_project_github_repo" />
        <field name="domain_force">
            ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
        </field>
    </record>
    <record id="project_github_sync_job_company_rule" model="ir.rule">
        <field name="name">GitHub synchronization job: multi-company</field>
        <field name="model_id" ref="model_project_github_sync_job" />
        <field name="domain_force">
            ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
        </field>
    </record>
</odoo>
