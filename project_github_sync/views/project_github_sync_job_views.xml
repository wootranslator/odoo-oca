<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="project_github_sync_job_view_list" model="ir.ui.view">
        <field name="name">project.github.sync.job.list</field>
        <field name="model">project.github.sync.job</field>
        <field name="arch" type="xml">
            <list
                create="0"
                decoration-danger="state == 'failed'"
                decoration-muted="state == 'done'"
            >
                <field name="create_date" />
                <field name="task_id" />
                <field name="kind" />
                <field name="state" widget="badge" />
                <field name="attempt_count" />
                <field name="next_attempt_at" optional="hide" />
                <field name="last_error" optional="show" />
                <button
                    name="action_retry"
                    type="object"
                    string="Retry"
                    icon="fa-refresh"
                    invisible="state != 'failed'"
                />
            </list>
        </field>
    </record>
    <record id="project_github_sync_job_view_form" model="ir.ui.view">
        <field name="name">project.github.sync.job.form</field>
        <field name="model">project.github.sync.job</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button
                        name="action_retry"
                        type="object"
                        string="Retry"
                        class="btn-primary"
                        invisible="state != 'failed'"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <field name="task_id" />
                        <field name="kind" />
                        <field name="message_id" invisible="kind != 'comment'" />
                        <field name="attempt_count" />
                        <field name="next_attempt_at" invisible="state != 'pending'" />
                        <field name="done_at" invisible="state == 'pending'" />
                        <field name="last_error" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="project_github_sync_job_view_search" model="ir.ui.view">
        <field name="name">project.github.sync.job.search</field>
        <field name="model">project.github.sync.job</field>
        <field name="arch" type="xml">
            <search>
                <field name="task_id" />
                <filter
                    name="failed"
                    string="Failed"
                    domain="[('state', '=', 'failed')]"
                />
                <filter
                    name="pending"
                    string="Pending"
                    domain="[('state', '=', 'pending')]"
                />
                <group>
                    <filter
                        name="group_state"
                        string="State"
                        context="{'group_by': 'state'}"
                    />
                    <filter
                        name="group_kind"
                        string="Kind"
                        context="{'group_by': 'kind'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="project_github_sync_job_action" model="ir.actions.act_window">
        <field name="name">GitHub synchronization</field>
        <field name="res_model">project.github.sync.job</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_failed': 1}</field>
    </record>
    <menuitem
        id="menu_project_github_sync_job"
        name="GitHub synchronization"
        parent="project.menu_project_config"
        action="project_github_sync_job_action"
        groups="project.group_project_manager"
        sequence="90"
    />
</odoo>
